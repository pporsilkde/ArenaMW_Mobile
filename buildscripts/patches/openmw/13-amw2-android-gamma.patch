diff --git a/apps/openmw/mwrender/renderingmanager.cpp b/apps/openmw/mwrender/renderingmanager.cpp
index da9d569..913782c 100644
--- a/apps/openmw/mwrender/renderingmanager.cpp
+++ b/apps/openmw/mwrender/renderingmanager.cpp
@@ -781,6 +781,18 @@ namespace MWRender
         for (auto itr = shadowDefines.begin(); itr != shadowDefines.end(); itr++)
             globalDefines[itr->first] = itr->second;
 
+        // Android launcher gamma is process-scoped because SDL gamma ramps are
+        // unreliable on GLES devices. Feed it into the scene shaders instead.
+        float shaderGamma = 1.f;
+        if (const char* gammaEnv = std::getenv("OPENMW_GAMMA"))
+        {
+            char* end = nullptr;
+            const float parsedGamma = std::strtof(gammaEnv, &end);
+            if (end != gammaEnv && std::isfinite(parsedGamma))
+                shaderGamma = std::clamp(parsedGamma, 0.5f, 3.f);
+        }
+        globalDefines["gamma"] = std::to_string(shaderGamma);
+
         globalDefines["forcePPL"] = Settings::Manager::getBool("force per pixel lighting", "Shaders") ? "1" : "0";
         globalDefines["clamp"] = Settings::Manager::getBool("clamp lighting", "Shaders") ? "1" : "0";
         globalDefines["preLightEnv"] = Settings::Manager::getBool("apply lighting to environment maps", "Shaders") ? "1" : "0";
diff --git a/files/shaders/groundcover_fragment.glsl b/files/shaders/groundcover_fragment.glsl
index af0f1b3..89db922 100644
--- a/files/shaders/groundcover_fragment.glsl
+++ b/files/shaders/groundcover_fragment.glsl
@@ -141,4 +141,7 @@ void main()
     gl_FragData[0].xyz = mix(gl_FragData[0].xyz, arenaBlendedFog, fogValue);
 
     applyShadowDebugOverlay();
+
+    // Launcher-controlled scene gamma. Clamp the base to avoid pow() on negative HDR intermediates.
+    gl_FragData[0].xyz = pow(max(gl_FragData[0].xyz, vec3(0.0)), vec3(1.0 / max(@gamma, 0.01)));
 }
