@@ -24,6 +24,16 @@ endif()
 add_library(maskedoc STATIC ${MOC_SOURCES})
 target_include_directories(maskedoc PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
 
+# Android/NDK r21e uses the compatibility-pinned sse2neon header installed by
+# the mobile build-time patch pipeline. Prefer correctness for occlusion
+# decisions over the small cost of precise min/max and division emulation.
+if(ANDROID AND (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|ARM64"))
+    target_compile_definitions(maskedoc PRIVATE
+        SSE2NEON_PRECISE_MINMAX=1
+        SSE2NEON_PRECISE_DIV=1
+    )
+endif()
+
 if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64|i[3-6]86")
     if(MSVC)
         # Main file must stay at a conservative baseline.
