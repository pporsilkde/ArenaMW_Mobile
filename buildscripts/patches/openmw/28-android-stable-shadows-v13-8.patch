+bool MWShadowTechnique::stabilizeShadowCameraToFrustumSlice(Frustum& frustum, osg::Camera* camera, double viewNear, double viewFar, std::vector<osg::Plane>& planeList)
+{
+    const osg::Matrixd light_p = camera->getProjectionMatrix();
+    const osg::Matrixd light_v = camera->getViewMatrix();
+
+    double left, right, bottom, top, zNear, zFar;
+    if (!light_p.getOrtho(left, right, bottom, top, zNear, zFar))
+        return false;
+
+    // 1. Rebuild this cascade's slice of the main view frustum in world space. Frustum corners
+    //    0,1,5,4 lie on the near plane and 3,2,6,7 on the matching far plane, so each pair shares
+    //    a ray from the eye and can be interpolated by distance along the frustum centre line.
+    static const unsigned int sNearCorner[4] = { 0, 1, 5, 4 };
+    static const unsigned int sFarCorner[4]  = { 3, 2, 6, 7 };
+
+    const double nearDistance = (frustum.centerNearPlane - frustum.eye) * frustum.frustumCenterLine;
+    const double farDistance = (frustum.centerFarPlane - frustum.eye) * frustum.frustumCenterLine;
+    const double span = farDistance - nearDistance;
+    if (span <= 0.0)
+        return false;
+
+    const double tNear = osg::clampBetween((viewNear - nearDistance) / span, 0.0, 1.0);
+    const double tFar = osg::clampBetween((viewFar - nearDistance) / span, 0.0, 1.0);
+    if (tFar <= tNear)
+        return false;
+
+    osg::Vec3d sliceCorners[8];
+    for (unsigned int i = 0; i < 4; ++i)
+    {
+        const osg::Vec3d& nearCorner = frustum.corners[sNearCorner[i]];
+        const osg::Vec3d& farCorner = frustum.corners[sFarCorner[i]];
+        const osg::Vec3d edge = farCorner - nearCorner;
+        sliceCorners[i] = nearCorner + edge * tNear;
+        sliceCorners[i + 4] = nearCorner + edge * tFar;
+    }
+
+    // 2. Fit a sphere rather than a light space box. The slice is a rigid body, so the radius of
+    //    its bounding sphere is the same no matter which way the camera is pointing. That is what
+    //    keeps the world size of a shadow texel - and hence the sharpness of the shadow edge -
+    //    constant while the player looks around, instead of jumping whenever the light space
+    //    bounding box happens to grow.
+    osg::Vec3d sphereCenter(0.0, 0.0, 0.0);
+    for (const osg::Vec3d& corner : sliceCorners)
+        sphereCenter += corner;
+    sphereCenter /= 8.0;
+
+    double radius = 0.0;
+    for (const osg::Vec3d& corner : sliceCorners)
+        radius = osg::maximum(radius, (corner - sphereCenter).length());
+    if (radius <= 0.0)
+        return false;
+
+    // 3. Everything below happens in the light's view space, where one shadow map texel covers a
+    //    fixed number of world units.
+    const osg::Vec2s textureSize = getShadowedScene()->getShadowSettings()->getTextureSize();
+    const double resolution = osg::maximum(1, static_cast<int>(textureSize.x()));
+    const double texelWorldSize = 2.0 * radius / resolution;
+
+    const osg::Vec3d center_lv = sphereCenter * light_v;
+
+    // Snap the cascade origin to whole texels. Without this the same silhouette lands in a
+    // slightly different texel every frame and the shadow edge visibly crawls and shimmers.
+    const double snappedX = std::floor(center_lv.x() / texelWorldSize) * texelWorldSize;
+    const double snappedY = std::floor(center_lv.y() / texelWorldSize) * texelWorldSize;
+
+    // Anything further from the light than the far side of the slice cannot shadow the slice, so
+    // the far plane can be pulled in for depth precision. The near plane is left alone because
+    // casters between the light and the slice must still be rasterised.
+    double minZ = dbl_max;
+    for (const osg::Vec3d& corner : sliceCorners)
+        minZ = osg::minimum(minZ, (corner * light_v).z());
+
+    const double tightenedFar = osg::minimum(zFar, -minZ + 2.0 * texelWorldSize);
+    if (tightenedFar > zNear)
+        zFar = tightenedFar;
+
+    camera->setProjectionMatrix(osg::Matrixd::ortho(snappedX - radius, snappedX + radius,
+                                                    snappedY - radius, snappedY + radius,
+                                                    zNear, zFar));
+
+    // Caster culling planes, expressed in light view space exactly as the unstabilised path does.
+    planeList.emplace_back(0.0, -1.0, 0.0, snappedY + radius);
+    planeList.emplace_back(0.0, 1.0, 0.0, -(snappedY - radius));
+    planeList.emplace_back(-1.0, 0.0, 0.0, snappedX + radius);
+    planeList.emplace_back(1.0, 0.0, 0.0, -(snappedX - radius));
+    // In view space, the light is at the most positive value, and we want to cull stuff beyond the minimum value.
+    planeList.emplace_back(0.0, 0.0, 1.0, -minZ);
+
+    return true;
+}
