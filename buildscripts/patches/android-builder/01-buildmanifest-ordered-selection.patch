+    /**
+     * Applies an ordered selection coming from build.ini or another authoritative source.
+     *
+     * Filenames are matched case-insensitively because Android filesystems and copied
+     * Morrowind installations do not always preserve the exact casing used by manifests.
+     * Requested entries are moved to the front in the exact requested order. When
+     * [authoritative] is true, entries not present in [ordered] are disabled; otherwise
+     * their enabled state is preserved. All entries are then renumbered to a dense, stable
+     * load order and persisted to SQLite in one update pass.
+     */
+    fun applyOrderedSelection(ordered: List<String>, authoritative: Boolean) {
+        val selected = arrayListOf<Mod>()
+
+        ordered.forEach { requested ->
+            val mod = mods.firstOrNull { it.filename.equals(requested, ignoreCase = true) }
+            if (mod != null && selected.none { it.filename.equals(mod.filename, ignoreCase = true) })
+                selected.add(mod)
+        }
+
+        val remaining = mods
+            .filter { candidate -> selected.none { it === candidate } }
+            .sortedBy { it.order }
+
+        var nextOrder = 1
+        selected.forEach { mod ->
+            var changed = false
+            if (!mod.enabled) {
+                mod.enabled = true
+                changed = true
+            }
+            if (mod.order != nextOrder) {
+                mod.order = nextOrder
+                changed = true
+            }
+            if (changed) mod.dirty = true
+            nextOrder += 1
+        }
+
+        remaining.forEach { mod ->
+            var changed = false
+            if (authoritative && mod.enabled) {
+                mod.enabled = false
+                changed = true
+            }
+            if (mod.order != nextOrder) {
+                mod.order = nextOrder
+                changed = true
+            }
+            if (changed) mod.dirty = true
+            nextOrder += 1
+        }
+
+        update()
+        mods.sortBy { it.order }
+    }
+
     /**
      * Performs DB updates for all mods marked as dirty
      */
