diff --git a/extern/maskedoc/CMakeLists.txt b/extern/maskedoc/CMakeLists.txt
index 825a1cf..54deae2 100644
--- a/extern/maskedoc/CMakeLists.txt
+++ b/extern/maskedoc/CMakeLists.txt
@@ -1,5 +1,16 @@
 include(CheckCXXCompilerFlag)
 
+# The Android builder is intentionally pinned to NDK r21e/Clang 9 for ABI and
+# dependency compatibility. Current sse2neon requires Clang 11+, so do not
+# compile MaskedOcclusionCulling on this legacy Android toolchain. SceneUtil
+# provides a conservative no-op culler on Android instead. Desktop builds keep
+# the normal MOC implementation.
+if(ANDROID)
+    add_library(maskedoc INTERFACE)
+    target_include_directories(maskedoc INTERFACE ${CMAKE_CURRENT_SOURCE_DIR})
+    return()
+endif()
+
 set(MOC_SOURCES
     MaskedOcclusionCulling.cpp
 )
