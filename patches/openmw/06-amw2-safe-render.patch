     {
         osg::ref_ptr<osg::OcclusionQueryNode> oqn = new osg::OcclusionQueryNode;
+#if defined(__ANDROID__)
+        // OSG OcclusionQueryNode takes ownership of the main camera pre/post draw callbacks.
+        // ArenaMW also uses those callbacks for its render pipeline, which makes OSG emit
+        // "osgOQ: QG: Invalid RQCB" on Android/GL4ES. Keep the sun itself but disable
+        // only its visibility queries on Android; sun glare/flash simply stay hidden.
+        oqn->setQueriesEnabled(false);
+#else
         oqn->setQueriesEnabled(true);
+#endif
 
